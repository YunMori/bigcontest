# Browser mock needs no API keys or backend.
VITE_APP_MODE=mock

# For local FastAPI/LangGraph integration, change mode to api and set the origin.
# Do not append /api; never place secrets in VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Pages base is passed as a shell/CI environment variable, not read from this file:
# VITE_BASE_PATH=/bigcontest/ npm run build
